{
  "manifest_version": 3,
  "name": "PRIVIS",
  "description": "Local eyes, local eraser, remote brain. SIH26171 — On-device Visual Perception for Light-weight Browser Agents.",
  "version": "0.1.0",
  "permissions": ["activeTab", "tabs", "scripting", "webNavigation", "storage", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background/service-worker.js"
  },
  "action": {
    "default_title": "PRIVIS",
    "default_popup": "extension/src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "dist/utils/dom-extractor.js",
        "dist/privacy/sanitizer/structural-redact.js",
        "dist/content/capture-content.js"
      ]
    }
  ]
}
